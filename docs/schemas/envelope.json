{
  "$comment": "generated by scripts/generate.ts from src/schema — do not edit by hand",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Envelope",
  "$defs": {
    "Envelope": {
      "anyOf": [
        {
          "$ref": "#/$defs/SuccessEnvelope"
        },
        {
          "$ref": "#/$defs/ErrorEnvelope"
        }
      ]
    },
    "SuccessEnvelope": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "version": {
          "type": "string",
          "description": "CLI version that produced this envelope."
        },
        "operation": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "Effective inputs after defaults."
        },
        "defaulted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of params the CLI filled in."
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Warning"
          }
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null for operations that do not touch the network."
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "pagination": {
          "$ref": "#/$defs/Pagination"
        },
        "dry_run": {
          "type": "boolean"
        },
        "data": {}
      },
      "required": [
        "ok",
        "version",
        "operation",
        "params",
        "defaulted",
        "warnings",
        "source",
        "dry_run",
        "data"
      ],
      "additionalProperties": false
    },
    "Warning": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "RETRIED",
            "OUTPUT_SCHEMA_MISMATCH"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "description": "Something the caller should react to."
    },
    "Source": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Full upstream URL the CLI requested."
        },
        "fetched_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ],
          "description": "When the response was received. Null on a dry run."
        }
      },
      "required": [
        "url",
        "fetched_at"
      ],
      "additionalProperties": false
    },
    "Currency": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "description": "Issue date the text was served for."
        },
        "latest_amended_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "up_to_date_as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "date",
        "latest_amended_on",
        "up_to_date_as_of"
      ],
      "additionalProperties": false,
      "description": "How current the served regulation text is, resolved fresh every run."
    },
    "Pagination": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "per_page": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "total_pages": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "next": {
          "description": "A ready to run command for the next page, or null.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "page",
        "per_page",
        "total",
        "total_pages",
        "next"
      ],
      "additionalProperties": false
    },
    "ErrorEnvelope": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "version": {
          "type": "string",
          "description": "CLI version that produced this envelope."
        },
        "operation": {
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "ok",
        "version",
        "operation",
        "error"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "USAGE",
            "NOT_FOUND",
            "RATE_LIMITED",
            "UPSTREAM_UNAVAILABLE",
            "NETWORK",
            "TIMEOUT",
            "UPSTREAM_ERROR",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string"
        },
        "status": {
          "description": "Upstream HTTP status when there was one.",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "retryable": {
          "type": "boolean"
        },
        "remediation": {
          "type": "string",
          "description": "What to run or change next."
        },
        "details": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "remediation",
        "details"
      ],
      "additionalProperties": false
    }
  }
}
