{
  "$comment": "generated by scripts/generate.ts from src/schema — do not edit by hand",
  "cli": {
    "name": "ecfr",
    "version": "0.3.0"
  },
  "targets": {
    "ecfr": {
      "name": "ecfr",
      "base_url": "https://www.ecfr.gov",
      "description": "The public eCFR API at ecfr.gov."
    }
  },
  "default_target": "ecfr",
  "environment": [
    {
      "name": "ECFR_OUTPUT",
      "description": "Default output format when neither --output nor --json is passed."
    },
    {
      "name": "ECFR_AGENT",
      "description": "Self-reported agent name, sent as X-Agent-Name on upstream calls and echoed in the envelope. For tracing only; nothing is authorized on it."
    }
  ],
  "policy": {
    "retries": 2,
    "backoff_ms": [
      500,
      2000
    ],
    "headers_timeout_ms": 30000,
    "body_timeout_ms": 300000,
    "base_url": "https://www.ecfr.gov"
  },
  "exit_codes": [
    {
      "exit": 0,
      "codes": [
        "OK"
      ],
      "when": "Success, including a dry run."
    },
    {
      "exit": 1,
      "codes": [
        "UPSTREAM_ERROR",
        "INTERNAL"
      ],
      "when": "Unexpected upstream 4xx or an internal failure."
    },
    {
      "exit": 2,
      "codes": [
        "USAGE"
      ],
      "when": "Bad flags, positionals, or values."
    },
    {
      "exit": 3,
      "codes": [
        "NOT_FOUND"
      ],
      "when": "ecfr.gov returned 404 for the request."
    },
    {
      "exit": 4,
      "codes": [
        "RATE_LIMITED",
        "UPSTREAM_UNAVAILABLE",
        "NETWORK",
        "TIMEOUT"
      ],
      "when": "Transient failure after retries were exhausted. Safe to retry later."
    }
  ],
  "error_codes": [
    "USAGE",
    "NOT_FOUND",
    "RATE_LIMITED",
    "UPSTREAM_UNAVAILABLE",
    "NETWORK",
    "TIMEOUT",
    "UPSTREAM_ERROR",
    "INTERNAL"
  ],
  "global_flags": [
    {
      "name": "--json",
      "description": "Write the JSON envelope to stdout. Alias for --output json; retained for compatibility."
    },
    {
      "name": "--output",
      "value": "<format>",
      "description": "Output format: \"json\" for the envelope, \"text\" for human-readable rendering. Defaults to json. Overrides --json; falls back to the ECFR_OUTPUT environment variable."
    },
    {
      "name": "--dry-run",
      "description": "Resolve the request and return the envelope without fetching the data. Only the small title list is read, to resolve a defaulted date."
    },
    {
      "name": "--max-bytes",
      "value": "<n>",
      "description": "Maximum serialized size of \"data\" in bytes before the response is truncated with a warning. 0 disables the bound."
    }
  ],
  "operations": [
    {
      "name": "titles",
      "kind": "list",
      "summary": "List all CFR titles",
      "description": "Lists the 50 CFR titles with their number, name, latest amendment date, latest issue date, and the date the eCFR says each is up to date as of. Reserved titles are included in data and hidden in the table.",
      "positional": null,
      "flags": [],
      "network": "remote",
      "untrusted": [
        "data"
      ],
      "title_scoped": false,
      "raw_output": null,
      "examples": [
        {
          "command": "ecfr titles",
          "description": "Table of every title"
        },
        {
          "command": "ecfr titles --json",
          "description": "Envelope with data.titles[]"
        }
      ],
